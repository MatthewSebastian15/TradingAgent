FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=10 \
    PYTHONPATH=/app/backend:/app/backend/tradingagents-core \
    XDG_CACHE_HOME=/root/.tradingagents/cache \
    YFINANCE_CACHE_DIR=/root/.tradingagents/cache/py-yfinance \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && mkdir -p /root/.tradingagents/cache/py-yfinance \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip supaya lebih stabil saat download package
RUN python -m pip install --upgrade pip setuptools wheel

# Install backend dependencies dulu
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install \
    --timeout 300 \
    --retries 10 \
    --prefer-binary \
    -r /app/backend/requirements.txt

# Copy tradingagents-core dan install dari folder lokal
COPY backend/tradingagents-core /app/backend/tradingagents-core
RUN pip install \
    --timeout 300 \
    --retries 10 \
    --prefer-binary \
    /app/backend/tradingagents-core

# Copy sisa backend code
COPY backend /app/backend

WORKDIR /app/backend
EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]