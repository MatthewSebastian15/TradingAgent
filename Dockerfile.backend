FROM python:3.11-slim@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0 AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=10 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install pip==25.3 setuptools==82.0.1 wheel==0.45.1

COPY backend/requirements.txt /build/backend/requirements.txt
COPY backend/tradingagents-core /build/backend/tradingagents-core

WORKDIR /build/backend

RUN pip wheel --wheel-dir=/wheels -r requirements.txt \
    && pip wheel --wheel-dir=/wheels ./tradingagents-core


FROM python:3.11-slim@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0 AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/backend:/app/backend/tradingagents-core \
    XDG_CACHE_HOME=/home/tradingagent/.tradingagents/cache \
    YFINANCE_CACHE_DIR=/home/tradingagent/.tradingagents/cache/py-yfinance \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        fonts-dejavu-core \
        libcairo2 \
        libfontconfig1 \
        libgdk-pixbuf-2.0-0 \
        libharfbuzz0b \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        shared-mime-info \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system tradingagent \
    && useradd --system --gid tradingagent --home-dir /home/tradingagent --create-home tradingagent \
    && mkdir -p /home/tradingagent/.tradingagents/cache /home/tradingagent/.tradingagents/logs

COPY --from=builder /wheels /wheels
COPY --chown=tradingagent:tradingagent backend /app/backend

WORKDIR /app/backend

RUN pip install --no-index --find-links=/wheels -r requirements.txt tradingagents==0.2.4 \
    && rm -rf /wheels \
    && chown -R tradingagent:tradingagent /app /home/tradingagent

USER tradingagent

EXPOSE 8000

CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]
