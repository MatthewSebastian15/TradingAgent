# ─── API Connection ────────────────────────────────────────────────────────────
# API backend untuk local dev.
# Docker/Nginx build juga bisa memakai http://localhost:8000 karena compose dev
# mem-bind backend ke 127.0.0.1:8000 di host.
VITE_API_BASE_URL=http://localhost:8000

# Legacy alias. Biarkan kosong kecuali masih ada tooling lama yang memakai VITE_API_URL.
VITE_API_URL=

# Clock shown in the top navbar.
# Defaults are Indonesia-local: Asia/Jakarta + WIB.
VITE_CLOCK_TIME_ZONE=Asia/Jakarta
VITE_CLOCK_LABEL=WIB

# ─── Mock Mode ─────────────────────────────────────────────────────────────────
# Aktifkan route mock untuk debugging UI:
# http://localhost:3000/analysis.test
VITE_ENABLE_MOCK=true

# Jangan pernah menaruh backend API key di frontend.
# Semua VITE_* bisa dilihat dari browser devtools.
