# ─── API Connection ────────────────────────────────────────────────────────────
# URL of the backend API server.
#
# Docker (nginx proxy): leave empty. nginx routes /api/* to the backend container.
# Local dev without Docker: set to http://localhost:8000
#
# Default (when unset): empty string → uses relative /api/* path (Docker-safe).
VITE_API_URL=

# ─── Mock Mode ─────────────────────────────────────────────────────────────────
# Set to "true" to expose the /analysis.test mock route in production builds. Local Vite dev mode exposes it automatically.
# Keep this false unless you intentionally want the mock UI available in a production build.
# Default: false
VITE_ENABLE_MOCK=false
