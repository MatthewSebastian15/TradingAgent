# ─── API Connection ────────────────────────────────────────────────────────────
# URL of the backend API server.
#
# Docker (nginx proxy): leave empty. nginx routes /api/* to the backend container.
# Local dev without Docker: set to http://localhost:8000
#
# Default (when unset): empty string → uses relative /api/* path (Docker-safe).
VITE_API_URL=

# ─── API Key Authentication ────────────────────────────────────────────────────
# Must match API_KEY in backend/.env if key-based auth is enabled on the backend.
# Leave empty when the backend API_KEY is also empty (no auth required).
VITE_API_KEY=

# ─── Mock Mode ─────────────────────────────────────────────────────────────────
# Set to "true" to enable the /analysis-mock route and serve mock data locally.
# Never set this to "true" in production.
# Default: false
VITE_ENABLE_MOCK=false
