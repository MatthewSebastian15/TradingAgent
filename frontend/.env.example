# ─── API Connection ────────────────────────────────────────────────────────────
# Backend API for local dev.
# Docker/Nginx builds can also use http://localhost:8000 because compose dev
# binds the backend to 127.0.0.1:8000 on the host.
VITE_API_BASE_URL=http://localhost:8000

# Legacy alias. Leave blank unless legacy tooling still uses VITE_API_URL.
VITE_API_URL=

# Clock shown in the top navbar.
# Defaults are Indonesia-local: Asia/Jakarta + WIB.
VITE_CLOCK_TIME_ZONE=Asia/Jakarta
VITE_CLOCK_LABEL=WIB

# ─── Mock Mode ─────────────────────────────────────────────────────────────────
# Enable mock routes for UI debugging:
# http://localhost:3000/analysis.test
VITE_ENABLE_MOCK=true

# Never put the backend API key on the frontend.
# All VITE_* are visible from the browser devtools.
