# URL of the FastAPI backend.
# - Local development (npm start / npm run dev): use the full URL with port
# - Docker: use /api (nginx proxies requests to the backend container)
VITE_API_URL=http://localhost:8000

# Must match API_KEY in backend/.env if key-based auth is enabled.
# Leave empty when API_KEY is empty in the backend.
VITE_API_KEY=

# Default value shown in the form for max debate rounds (1–5).
VITE_DEFAULT_MAX_DEBATE_ROUNDS=1

# Set to true to route /analysis to the mock page instead of the real backend.
# Useful for UI testing without a running backend.
VITE_ENABLE_MOCK=false
