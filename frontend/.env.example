# FastAPI backend URL.
# Local development:
# VITE_API_URL=http://localhost:8000
# Docker/nginx frontend:
# VITE_API_URL=/api
VITE_API_URL=http://localhost:8000

# Must match API_KEY in backend/.env if key-based auth is enabled.
# Leave empty when API_KEY is empty in the backend.
VITE_API_KEY=

# Default value shown in the form for max debate rounds. Valid range: 1-5.
VITE_DEFAULT_MAX_DEBATE_ROUNDS=1

# true = /analysis opens the mock UI and /analysis-live opens the real backend UI.
# false = /analysis opens the real backend UI and /analysis-mock opens the mock UI.
VITE_ENABLE_MOCK=false
