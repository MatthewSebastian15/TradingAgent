# Git
.git/
**/.git/

# Local environment files
**/.env
**/.env.*
*.env
!**/.env.example

# Python bytecode, caches, and virtual environments
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# Backend runtime data
backend/.cache/
backend/data_cache/
backend/results/
backend/**/*.db
backend/**/*.sqlite
backend/**/*.sqlite3
packages/*.egg-info/

# Frontend dependencies and build output
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/coverage/

# Logs and archives
*.log
logs/
*.zip
*.tar.gz
