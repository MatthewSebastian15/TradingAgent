# ─── Server ───
# Optional API auth.
# Leave blank for local development only.
# For production, fill in API_KEY.
API_KEY=

# Signed browser owner session.
# Required in production. Development blank value uses a persistent cache secret.
OWNER_SESSION_SECRET=
# Defaults to ANALYSIS_JOB_TTL_SECONDS when blank.
OWNER_SESSION_TTL_SECONDS=

# ─── Runtime Cache Overrides ──────────────────────────────────────────────────
# Blank values use platform defaults.
XDG_CACHE_HOME=
YFINANCE_CACHE_DIR=
YFINANCE_TICKER_CACHE_MAX_ENTRIES=512
# Blank defaults to max(16, min(32, CPU count + 4)). Raise this when Docker logs
# show "active timed-call capacity is saturated" during parallel data collection.
TRADINGAGENTS_TIMEOUT_MAX_ACTIVE_CALLS=
# Blank defaults to active-call capacity.
TRADINGAGENTS_TIMEOUT_MAX_ABANDONED_CALLS=
# Seconds a data call may wait for timed-call capacity before failing fast.
TRADINGAGENTS_TIMEOUT_CAPACITY_WAIT_SECONDS=5

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Required: set LLM_PROVIDER to one of:
#   google | openai | anthropic | deepseek
LLM_PROVIDER=

# Required: models used by the pipeline. The backend has no hardcoded model fallback.
# deep_think_llm  → Research Manager and Portfolio Manager (heavier reasoning)
# quick_think_llm → all other agents (faster, cheaper)
QUICK_THINK_LLM=
DEEP_THINK_LLM=
# Comma list of agents to run on deep_think_llm instead of quick.
# Accepted: bull_researcher, bear_researcher, risk_analysts. Blank = current behavior.
DEEP_THINK_AGENTS=

# ─── LLM API Keys ─────────────────────────────────────────────────────────────
# Set only the key for your LLM_PROVIDER; the backend picks it automatically.
#   google → GOOGLE_API_KEY (or GEMINI_API_KEY) · openai → OPENAI_API_KEY
#   anthropic → ANTHROPIC_API_KEY · deepseek → DEEPSEEK_API_KEY
# Optional override for openai/deepseek custom endpoints: LLM_BASE_URL (unset = provider default).
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Optional but recommended for better market/news/fundamental fallback.
# Used together with yfinance when a field is missing or when news can be enriched.
ALPHA_VANTAGE_API_KEY=

# Required by SEC fair-access policy for US companyfacts fallback.
SEC_USER_AGENT=TradingAgents/1.0 your_email@example.com

# ─── Strict AI Analysis News Pipeline ─────────────────────────────────────────
GOOGLE_NEWS_LIGHT_API_KEY=
MARKETAUX_API_KEY=
NEWSDATA_API_KEY=
# Tuning knobs (NEWS_PROVIDER_PRIORITY, NEWS_MAX_ARTICLES_*, relevance scores, …)
# have code defaults in config_defaults.py — see ai/setup.md. Set here only to override.

# ─── Finnhub API ──────────────────────────────────────────────────────────────
# Finnhub is skipped when the API key is empty.
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_ENABLED=true

# ─── Economic tab ─────────────────────────────────────────────────────────────
# Only WTO needs a key (free registration at the WTO developer portal). Leave
# empty to hide the WTO panel on the Trade sub-tab; all other Economic sources
# (Fed, World Bank, IMF, ECB, Treasury) need no key.
ECONOMIC_WTO_API_KEY=

# ─── RAG Chatbot ──────────────────────────────────────────────────────────────
RAG_CHATBOT_ENABLED=true
RAG_CHATBOT_LLM_MODEL=
# Pool TTLs, context limits, and RAG_CHATBOT_CHAT_TIMEOUT_SECONDS have code
# defaults in config_defaults.py — see ai/setup.md. Set here only to override.

# ─── Postgres (analyses storage, Phase 1) ───────────────────────────────────────
# Only needed when ANALYSIS_STORAGE_BACKEND=postgres. Default backend is sqlite.
# Set ANALYSIS_STORAGE_BACKEND=postgres at cutover; keep it unset/sqlite otherwise.
# Generate a strong password: openssl rand -hex 16
# Then set ANALYSIS_DATABASE_URL with the same password. Literal "change-me" is rejected at startup.
POSTGRES_PASSWORD=
ANALYSIS_DATABASE_URL=
