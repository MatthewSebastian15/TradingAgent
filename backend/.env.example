# ─── Server ───────────────────────────────────────────────────────────────────
# Runtime environment:
# - development: default for personal/local dev
# - production: use only if actually deploying
APP_ENV=development

# Development CORS whitelist.
# Jangan gunakan "*" walaupun project personal.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Optional API auth.
# Leave blank for local development only.
# For production, fill in the API_KEY and enable REQUIRE_API_KEY_FOR_RATE_LIMIT=true.
API_KEY=
REQUIRE_API_KEY_FOR_RATE_LIMIT=false

# Only trust X-Forwarded-For/X-Real-IP from these direct client hosts.
# Leave blank for local dev without reverse proxy.
TRUSTED_PROXY_HOSTS=

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Required: set LLM_PROVIDER to one of:
#   google | openai | anthropic | deepseek | openrouter | ollama
LLM_PROVIDER=

# Required: models used by the pipeline. The backend has no hardcoded model fallback.
# deep_think_llm  → Research Manager and Portfolio Manager (heavier reasoning)
# quick_think_llm → all other agents (faster, cheaper)
DEEP_THINK_LLM=
QUICK_THINK_LLM=

# ─── LLM API Keys ─────────────────────────────────────────────────────────────
# Fill only the key for the provider you selected above.
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional but recommended for better market/news/fundamental fallback.
# Used together with yfinance when a field is missing or when news can be enriched.
ALPHA_VANTAGE_API_KEY=

# Optional market-data vendor order. Keep yfinance first for broad Yahoo-compatible
# symbols, then use Alpha Vantage as enrichment/fallback.
DATA_VENDOR_CORE_STOCK_APIS=yfinance,alpha_vantage
DATA_VENDOR_TECHNICAL_INDICATORS=yfinance,alpha_vantage
DATA_VENDOR_FUNDAMENTAL_DATA=yfinance,alpha_vantage
DATA_VENDOR_NEWS_DATA=yfinance,alpha_vantage

# Ollama (only when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
