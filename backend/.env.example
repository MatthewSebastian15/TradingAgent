# ─── Server ───────────────────────────────────────────────────────────────────
# Runtime environment:
# - development: default for personal/local dev
# - production: use only if actually deploying
APP_ENV=development

# Development CORS whitelist.
# Jangan gunakan "*" walaupun project personal.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Optional API auth.
# Leave blank for local development only.
# For production, fill in the API_KEY and enable REQUIRE_API_KEY_FOR_RATE_LIMIT=true.
API_KEY=
REQUIRE_API_KEY_FOR_RATE_LIMIT=false

# Only trust X-Forwarded-For/X-Real-IP from these direct client hosts.
# Leave blank for local dev without reverse proxy.
TRUSTED_PROXY_HOSTS=

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Required: set LLM_PROVIDER to one of:
#   google | openai | anthropic | deepseek | openrouter | ollama
LLM_PROVIDER=

# Required: models used by the pipeline. The backend has no hardcoded model fallback.
# deep_think_llm  → Research Manager and Portfolio Manager (heavier reasoning)
# quick_think_llm → all other agents (faster, cheaper)
DEEP_THINK_LLM=
QUICK_THINK_LLM=

# ─── LLM API Keys ─────────────────────────────────────────────────────────────
# Fill only the key for the provider you selected above.
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional but recommended for better market/news/fundamental fallback.
# Used together with yfinance when a field is missing or when news can be enriched.
ALPHA_VANTAGE_API_KEY=

# ─── Finnhub API ─────────────────────────────────────────────────────────────
# Default disabled so local development and tests never consume quota by accident.
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_ENABLED=true

# Timeout and retry.
FINNHUB_TIMEOUT_SECONDS=15
FINNHUB_MAX_RETRIES=1
FINNHUB_RETRY_BACKOFF_SECONDS=1

# Feature flags.
FINNHUB_ENABLE_STOCK_DATA=true
FINNHUB_ENABLE_FUNDAMENTALS=true
FINNHUB_ENABLE_NEWS=false
FINNHUB_ENABLE_SENTIMENT=false
FINNHUB_ENABLE_EVENTS=false
FINNHUB_ENABLE_INSIDER=false
FINNHUB_ENABLE_FOREX=false
FINNHUB_ENABLE_CRYPTO=false
FINNHUB_ENABLE_SYMBOL_RESOLVER=true

# Cache TTL.
FINNHUB_QUOTE_CACHE_TTL_SECONDS=120
FINNHUB_OHLCV_CACHE_TTL_SECONDS=21600
FINNHUB_PROFILE_CACHE_TTL_SECONDS=604800
FINNHUB_METRICS_CACHE_TTL_SECONDS=604800
FINNHUB_FINANCIAL_STATEMENT_CACHE_TTL_SECONDS=2592000
FINNHUB_NEWS_CACHE_TTL_SECONDS=3600
FINNHUB_SENTIMENT_CACHE_TTL_SECONDS=3600
FINNHUB_EVENT_CACHE_TTL_SECONDS=43200
FINNHUB_INSIDER_CACHE_TTL_SECONDS=43200
FINNHUB_FOREX_CACHE_TTL_SECONDS=300
FINNHUB_CRYPTO_CACHE_TTL_SECONDS=120
FINNHUB_SYMBOL_CACHE_TTL_SECONDS=2592000

# Request budget.
FINNHUB_MAX_CALLS_PER_ANALYSIS=12
# Request budget dibuat lebih longgar untuk balanced pipeline. Cache hit tidak
# dihitung sebagai vendor call, tetapi satu analisis tetap bisa butuh price,
# fundamentals, statements, news, dan fallback vendor.
DATA_VENDOR_MAX_CALLS_PER_ANALYSIS=40
DATA_COLLECTION_WORKERS=3

# Optional market-data vendor order. Keep yfinance primary, Finnhub as active
# fallback/enrichment, and Alpha Vantage as the final backup to conserve quota.
DATA_VENDOR_CORE_STOCK_APIS=yfinance,finnhub,alpha_vantage
DATA_VENDOR_QUOTE_DATA=yfinance,finnhub,alpha_vantage
DATA_VENDOR_TECHNICAL_INDICATORS=yfinance,finnhub,alpha_vantage
DATA_VENDOR_FUNDAMENTAL_DATA=yfinance,finnhub,alpha_vantage
DATA_VENDOR_FINANCIAL_STATEMENTS=yfinance,alpha_vantage,finnhub
DATA_VENDOR_NEWS_DATA=yfinance,finnhub,alpha_vantage
DATA_VENDOR_GLOBAL_NEWS_DATA=yfinance,finnhub,alpha_vantage
DATA_VENDOR_SENTIMENT_DATA=finnhub,alpha_vantage
DATA_VENDOR_SOCIAL_SENTIMENT=finnhub
DATA_VENDOR_EVENT_DATA=finnhub
DATA_VENDOR_ANALYST_RATING=finnhub
DATA_VENDOR_INSIDER_DATA=finnhub,alpha_vantage,yfinance
DATA_VENDOR_FOREX_DATA=finnhub,alpha_vantage
DATA_VENDOR_CRYPTO_DATA=finnhub,alpha_vantage

# Data vendor guards.
# Personal devs are more stable using single-source news. Enable true only
# if you really want to pay additional request fees from all vendors.
DATA_VENDOR_ENABLE_MULTI_SOURCE_NEWS=false
DATA_VENDOR_ENABLE_MULTI_SOURCE_PRICE=false
DATA_VENDOR_ENABLE_FINNHUB_FALLBACK=true
# Finnhub enrichment is optional. Leave it false unless the API key/plan is required.
# Supports sentiment, event, recommendation, insider, and news endpoints.
DATA_VENDOR_ENABLE_FINNHUB_ENRICHMENT=false
DATA_VENDOR_REQUIRE_SOURCE_METADATA=true
DATA_VENDOR_RETURN_PARTIAL_ON_FAILURE=true

# News limits.
MAX_NEWS_PER_VENDOR=10
MAX_TOTAL_NEWS_ITEMS=25
NEWS_DEDUP_BY=url,title
NEWS_MIN_RELEVANCE_SCORE=0.35

# Symbol defaults.
DEFAULT_INDONESIA_SUFFIX=.JK
DEFAULT_FOREX_EXCHANGE=OANDA
DEFAULT_CRYPTO_EXCHANGE=BINANCE
DEFAULT_US_EXCHANGE=US

# Ollama (only when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
