# ─── Server ───────────────────────────────────────────────────────────────────
# Runtime environment:
# - development: default for personal/local dev
# - production: use only if actually deploying
APP_ENV=development

# Development CORS whitelist.
# Jangan gunakan "*" walaupun project personal.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Optional API auth.
# Leave blank for local development only.
# For production, fill in the API_KEY and enable REQUIRE_API_KEY_FOR_RATE_LIMIT=true.
API_KEY=
REQUIRE_API_KEY_FOR_RATE_LIMIT=false

# Signed browser owner session.
# Required in production. Development blank value uses a persistent cache secret.
OWNER_SESSION_SECRET=
# Defaults to ANALYSIS_JOB_TTL_SECONDS when blank.
OWNER_SESSION_TTL_SECONDS=

# ─── Advanced Runtime Settings ────────────────────────────────────────────────
# Worker and pipeline timeout defaults.
PIPELINE_TIMEOUT_SECONDS=600
PREFLIGHT_TIMEOUT_SECONDS=30
PROCESS_POOL_WORKERS=2
PROCESS_POOL_MAX_TASKS_PER_CHILD=1
DATA_COLLECTION_WORKERS=12
ANALYST_PARALLEL_WORKERS=3
DEFAULT_MAX_DEBATE_ROUNDS=3

# Rate limiting and request size.
REQUEST_RATE_LIMIT_PER_MINUTE=20
STREAM_RATE_LIMIT_PER_MINUTE=8
MAX_CONCURRENT_REQUESTS_PER_KEY=2
MAX_CONCURRENT_STREAMS_PER_KEY=1
REQUEST_BODY_MAX_BYTES=16777216
RATE_LIMIT_STORAGE_BACKEND=memory
RATE_LIMIT_DB_PATH=.cache/rate_limits.sqlite3

# LLM and tool resilience.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
PROVIDER_SDK_MAX_RETRIES=0
TOOL_TIMEOUT_SECONDS=45
TOOL_MAX_RETRIES=2

# Result, job, and market-data cache.
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=512
ANALYSIS_RESULT_CACHE_TTL_SECONDS=28800
ANALYSIS_RESULT_CACHE_MAX_ENTRIES=256
ANALYSIS_JOB_TTL_SECONDS=28800
ANALYSIS_JOB_MAX_ENTRIES=256
ANALYSIS_JOB_MAX_ACTIVE=32
ANALYSIS_JOB_EVENT_REPLAY_LIMIT=500
ANALYSIS_JOB_CACHE_DB_PATH=.cache/analysis_jobs.sqlite3
ANALYSIS_JOB_STORE_BACKEND=sqlite
ANALYSIS_JOB_ROUTING_MODE=sticky_sessions
ANALYSIS_DB_PATH=.cache/analysis_history.sqlite3
ANALYSIS_STORAGE_BACKEND=sqlite
ANALYSIS_HISTORY_MAX_ROWS=1000
ANALYSIS_HISTORY_DEFAULT_LIMIT=25
DATA_CACHE_BACKEND=sqlite
DATA_CACHE_DB_PATH=.cache/market_data.sqlite3
DATA_CACHE_TTL_SECONDS=900
DATA_CACHE_MAX_ENTRIES=512
PRICE_MAX_FALLBACK_DAYS=7

# LLM exact response cache. Safe because it only hits when provider, model,
# agent, schema, schema version, and full prompt hash are identical.
LLM_EXACT_CACHE_ENABLED=true
LLM_EXACT_CACHE_TTL_SECONDS=1800
LLM_EXACT_CACHE_MAX_ENTRIES=1024
LLM_EXACT_CACHE_DB_PATH=.cache/llm_exact_cache.sqlite3

# Semantic cache is disabled by default because trading decisions are time-sensitive.
LLM_SEMANTIC_CACHE_ENABLED=false
LLM_SEMANTIC_CACHE_TTL_SECONDS=3600
LLM_SEMANTIC_CACHE_MAX_ENTRIES=2048
LLM_SEMANTIC_CACHE_DB_PATH=.cache/llm_semantic_cache.sqlite3
LLM_SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.97
LLM_SEMANTIC_CACHE_TARGETS=news_summary,company_profile

# Runtime cache paths. Blank values use platform defaults.
XDG_CACHE_HOME=
YFINANCE_CACHE_DIR=
YFINANCE_TICKER_CACHE_MAX_ENTRIES=512
# Blank defaults to max(16, min(32, CPU count + 4)). Raise this when Docker logs
# show "active timed-call capacity is saturated" during parallel data collection.
TRADINGAGENTS_TIMEOUT_MAX_ACTIVE_CALLS=
# Blank defaults to active-call capacity.
TRADINGAGENTS_TIMEOUT_MAX_ABANDONED_CALLS=
# Seconds a data call may wait for timed-call capacity before failing fast.
TRADINGAGENTS_TIMEOUT_CAPACITY_WAIT_SECONDS=5

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Required: set LLM_PROVIDER to one of:
#   google | openai | anthropic | deepseek | openrouter | ollama
LLM_PROVIDER=google

# Required: models used by the pipeline. The backend has no hardcoded model fallback.
# deep_think_llm  → Research Manager and Portfolio Manager (heavier reasoning)
# quick_think_llm → all other agents (faster, cheaper)
QUICK_THINK_LLM=gemini-3.1-flash-lite
DEEP_THINK_LLM=gemini-3.5-flash
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=
LLM_BUDGET_FAST=6
LLM_BUDGET_BALANCED=9
LLM_BUDGET_DEEP=12
DEBUG_ENDPOINTS_ENABLED=false

# ─── LLM API Keys ─────────────────────────────────────────────────────────────
# LLM_API_KEY is the general key for the active provider. Legacy provider keys
# are left here only for local compatibility.
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional but recommended for better market/news/fundamental fallback.
# Used together with yfinance when a field is missing or when news can be enriched.
ALPHA_VANTAGE_API_KEY=

# Required by SEC fair-access policy for US companyfacts fallback.
SEC_USER_AGENT=TradingAgents/1.0 your_email@example.com

# Structured company-news providers.
# Google News Light is the primary source. MarketAux and NewsData.io are fallback sources.
GOOGLE_NEWS_LIGHT_API_KEY=
MARKETAUX_API_KEY=
NEWSDATA_API_KEY=
NEWS_PROVIDER_PRIORITY=google_news_light,marketaux,newsdata
NEWS_ENABLED_PROVIDERS=google_news_light,marketaux,newsdata
NEWS_DEFAULT_WINDOW_DAYS=30
NEWS_MAX_ARTICLES_PER_PROVIDER=20
NEWS_MAX_ARTICLES_FOR_PROMPT=10
NEWS_MAX_ARTICLES_FOR_UI=30
NEWS_MIN_RELEVANCE_SCORE=40
NEWS_PROMPT_MIN_RELEVANCE_SCORE=55
NEWS_CACHE_ENABLED=true
NEWS_CACHE_TTL_MINUTES=360
NEWS_CACHE_DB_PATH=.cache/news_data.sqlite3
NEWS_CACHE_MAX_ENTRIES=512
NEWS_DEBUG_RAW_RESPONSE=false
NEWS_LOG_PROVIDER_REQUESTS=true
NEWS_VENDOR_TIMEOUT_SECONDS=15
NEWS_VENDOR_MAX_RETRIES=2
NEWS_FETCH_SECONDARY_ALWAYS=false
NEWS_SECONDARY_FETCH_THRESHOLD=3
NEWS_ENABLE_YFINANCE_FALLBACK=true

# ─── Finnhub API ─────────────────────────────────────────────────────────────
# Finnhub is enabled as an optional fallback. It is skipped when the API key
# is empty, so local development does not consume quota by accident.
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_ENABLED=true

# Timeout and retry.
FINNHUB_TIMEOUT_SECONDS=15
FINNHUB_MAX_RETRIES=1
FINNHUB_RETRY_BACKOFF_SECONDS=1

# Feature flags.
FINNHUB_ENABLE_STOCK_DATA=true
FINNHUB_ENABLE_FUNDAMENTALS=true
FINNHUB_ENABLE_NEWS=true
FINNHUB_ENABLE_SENTIMENT=true
FINNHUB_ENABLE_EVENTS=true
FINNHUB_ENABLE_INSIDER=true
FINNHUB_ENABLE_FOREX=false
FINNHUB_ENABLE_CRYPTO=false
FINNHUB_ENABLE_SYMBOL_RESOLVER=true

# Cache TTL.
FINNHUB_QUOTE_CACHE_TTL_SECONDS=120
FINNHUB_OHLCV_CACHE_TTL_SECONDS=21600
FINNHUB_PROFILE_CACHE_TTL_SECONDS=604800
FINNHUB_METRICS_CACHE_TTL_SECONDS=604800
FINNHUB_FINANCIAL_STATEMENT_CACHE_TTL_SECONDS=2592000
FINNHUB_NEWS_CACHE_TTL_SECONDS=3600
FINNHUB_SENTIMENT_CACHE_TTL_SECONDS=3600
FINNHUB_EVENT_CACHE_TTL_SECONDS=43200
FINNHUB_INSIDER_CACHE_TTL_SECONDS=43200
FINNHUB_FOREX_CACHE_TTL_SECONDS=300
FINNHUB_CRYPTO_CACHE_TTL_SECONDS=120
FINNHUB_SYMBOL_CACHE_TTL_SECONDS=2592000

# Request budget.
FINNHUB_MAX_CALLS_PER_ANALYSIS=12
# Request budget dibuat lebih longgar untuk balanced pipeline. Cache hit tidak
# dihitung sebagai vendor call, tetapi satu analisis tetap bisa butuh price,
# fundamentals, statements, news, dan fallback vendor.
DATA_VENDOR_MAX_CALLS_PER_ANALYSIS=60

# Optional market-data vendor order. Keep yfinance primary, Finnhub as active
# fallback/enrichment, and Alpha Vantage as the final backup to conserve quota.
DATA_VENDOR_CORE_STOCK_APIS=yfinance,finnhub,alpha_vantage
DATA_VENDOR_QUOTE_DATA=yfinance,finnhub,alpha_vantage
DATA_VENDOR_TECHNICAL_INDICATORS=yfinance,finnhub,alpha_vantage
DATA_VENDOR_FUNDAMENTAL_DATA=yfinance,finnhub,alpha_vantage
DATA_VENDOR_FINANCIAL_STATEMENTS=yfinance,sec_companyfacts,alpha_vantage,finnhub
DATA_VENDOR_NEWS_DATA=google_news_light,marketaux,newsdata,yfinance,finnhub,alpha_vantage
DATA_VENDOR_GLOBAL_NEWS_DATA=finnhub,alpha_vantage,yfinance
DATA_VENDOR_SENTIMENT_DATA=finnhub,alpha_vantage
DATA_VENDOR_SOCIAL_SENTIMENT=finnhub
DATA_VENDOR_EVENT_DATA=finnhub
DATA_VENDOR_ANALYST_RATING=finnhub
DATA_VENDOR_INSIDER_DATA=finnhub,alpha_vantage,yfinance
DATA_VENDOR_FOREX_DATA=finnhub,alpha_vantage
DATA_VENDOR_CRYPTO_DATA=finnhub,alpha_vantage

# Data vendor guards.
# Multi-source news is enabled so global/company context can be cross-checked.
# Disable only when quota is more important than coverage.
DATA_VENDOR_ENABLE_MULTI_SOURCE_NEWS=true
DATA_VENDOR_ENABLE_MULTI_SOURCE_PRICE=false
DATA_VENDOR_ENABLE_FINNHUB_FALLBACK=true
# Finnhub enrichment supports sentiment, event, recommendation, insider, and news endpoints.
# Keep FINNHUB_API_KEY empty in local tests if quota should not be consumed.
DATA_VENDOR_ENABLE_FINNHUB_ENRICHMENT=true
DATA_VENDOR_REQUIRE_SOURCE_METADATA=true
DATA_VENDOR_RETURN_PARTIAL_ON_FAILURE=true

# News limits.
MAX_NEWS_PER_VENDOR=10
MAX_TOTAL_NEWS_ITEMS=25
NEWS_DEDUP_BY=url,title
DATA_VENDOR_NEWS_MIN_RELEVANCE_SCORE=0.35

# Symbol defaults.
DEFAULT_INDONESIA_SUFFIX=.JK
DEFAULT_FOREX_EXCHANGE=OANDA
DEFAULT_CRYPTO_EXCHANGE=BINANCE
DEFAULT_US_EXCHANGE=US

# Ollama (only when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
