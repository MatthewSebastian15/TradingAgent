# ─── Server ───────────────────────────────────────────────────────────────────
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: require an API key on every request from the frontend
# Leave empty to disable key-based auth
API_KEY=

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to one of:
#   google | openai | anthropic | deepseek | xai | qwen | glm | openrouter | ollama | azure
LLM_PROVIDER=google

# Models used by the pipeline.
# deep_think_llm  → Research Manager and Portfolio Manager (heavier reasoning)
# quick_think_llm → all other agents (faster, cheaper)
DEEP_THINK_LLM=gemini-2.5-flash
QUICK_THINK_LLM=gemini-2.5-flash

# ─── LLM API Keys ─────────────────────────────────────────────────────────────
# Fill only the key for the provider you selected above.
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
OPENROUTER_API_KEY=

# Azure OpenAI (only when LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=

# Ollama (only when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ─── Pipeline ─────────────────────────────────────────────────────────────────
# ANALYSIS_MODE: balanced (9-call fixed pipeline) or classic (full graph)
ANALYSIS_MODE=balanced

# Hard timeout for one pipeline run, in seconds
PIPELINE_TIMEOUT_SECONDS=600

# How many parallel pipeline workers to run (max 1 per CPU core, cap 4)
PROCESS_POOL_WORKERS=4

# Default max debate rounds when the request does not specify one (1–5)
MAX_DEBATE_ROUNDS=1

# ─── Rate Limiting ────────────────────────────────────────────────────────────
REQUEST_RATE_LIMIT_PER_MINUTE=20
STREAM_RATE_LIMIT_PER_MINUTE=8
MAX_CONCURRENT_REQUESTS_PER_KEY=2
MAX_CONCURRENT_STREAMS_PER_KEY=1
