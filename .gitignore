# Local environment files
.env
.env.*
*.env
!**/.env.example

# Python bytecode and caches
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.pyre/
**/.pytype/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Backend runtime data
backend/.cache/
backend/data_cache/
backend/results/
backend/**/*.db
backend/**/*.sqlite
backend/**/*.sqlite3

# Python packaging
build/
dist/
sdist/
*.egg
*.egg-info/
backend/tradingagents-core/tradingagents.egg-info/

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/coverage/

# Logs and local artifacts
*.log
logs/
*.zip
*.tar.gz

# OS and editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
